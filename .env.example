# Copy to .env and fill in the keys you have.
#
# RapidAPI - one key works for every listing in README.md.
# Subscribe to an API's free BASIC plan (100 requests/month), then copy the key
# from the Endpoints tab.
RAPIDAPI_KEY=

# Apify - needed only for the bulk scrapers (Korean IPO / cheongyak, tenders,
# permits, SEC). Console -> Settings -> API & Integrations.
APIFY_TOKEN=
